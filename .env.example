# All values are optional. The app runs fully in demo mode without any of them.
# Copy to .env and fill in what you have.

# Gemini API (free tier) — required for lesson generation + AI speaking/writing feedback.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs are configurable because free-tier availability changes often.
# Defaults: gemini-2.5-flash-lite, gemini-2.0-flash-lite, gemini-2.5-flash
GEMINI_MODEL_LITE=
GEMINI_MODEL_LITE_ALT=
GEMINI_MODEL_FLASH=

# Groq — optional, free Whisper transcription. Without it the browser's free
# live transcript or manual typing is used.
GROQ_API_KEY=

# Azure Speech — optional, pronunciation scoring. Free F0 tier = 5 audio hrs/month.
# Without it, drills run in practice mode (record + listen back).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# MongoDB — optional. Without it the app uses a local JSON file store (.data/store.json).
MONGODB_URI=

# Single-user password gate — optional. Unset = app runs open in local demo mode.
APP_PASSWORD=
